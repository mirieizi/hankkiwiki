<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hankki.domain.diet.mapper.DietMealItemMapper">

    <insert id="insertDietMealItem" parameterType="DietMealItem">
        INSERT INTO diet_meal_item (diet_id, meal_item_id)
        VALUES (#{dietId}, #{mealItemId})
    </insert>

    <select id="findByDietId" resultType="DietMealItem">
        SELECT id, diet_id, meal_item_id
        FROM diet_meal_item
        WHERE diet_id = #{dietId}
    </select>

</mapper>
