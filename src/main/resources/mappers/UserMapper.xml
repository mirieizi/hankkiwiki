<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hankki.domain.user.mapper.UserMapper">

  <resultMap id="UserMap" type="com.hankki.domain.user.entity.User">
    <id     property="id"          column="user_id"/>
    <result property="email"       column="user_email"/>
    <result property="password"    column="user_password"/>
    <result property="nickname"    column="user_nickname"/>
    <result property="dailyUsage"  column="user_dailyusage"/>
  </resultMap>

  <select id="selectById" resultMap="UserMap">
    SELECT * FROM `user`
    WHERE user_id = #{id}
  </select>

  <select id="selectAll" resultMap="UserMap">
    SELECT * FROM `user`
    WHERE deleted = FALSE
  </select>

  <insert id="insert" parameterType="com.hankki.domain.user.entity.User" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO `user`
      (user_email, user_password, user_nickname, user_dailyusage)
    VALUES
      (#{email}, #{password}, #{nickname}, #{dailyUsage})
  </insert>

  <update id="update" parameterType="com.hankki.domain.user.entity.User">
    UPDATE `user`
      SET user_email      = #{email},
          user_password   = #{password},
          user_nickname   = #{nickname},
          user_dailyusage = #{dailyUsage}
    WHERE user_id = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM `user`
    WHERE user_id = #{id}
  </delete>
  
  <!-- 이메일로 조회 -->
  <select id="selectByEmail" resultMap="UserMap" parameterType="String">
    SELECT *
      FROM `user`
    WHERE user_email = #{email}
      AND deleted = FALSE
  </select>

</mapper>
