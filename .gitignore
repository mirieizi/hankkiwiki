##################################
# ☕ Backend (Spring Boot, Maven)
##################################
/backend/target/
/backend/.mvn/
!/backend/.mvn/wrapper/maven-wrapper.jar
/backend/mvnw
/backend/mvnw.cmd
/backend/*.iml

# Spring 설정 관련
/backend/.env
/backend/application-*.yml
/backend/application-*.properties
/backend/*.sql
/backend/*.dump

# 데이터 폴더 (MySQL, Redis 등)
backend/mysql-data/
backend/redis-data/
backend/dump.rdb

##################################
# 🌐 Frontend (Vue.js, Node.js)
##################################
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.*          # 예: .env.production, .env.development
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/.output/        # Nuxt 등 일부 프레임워크
/frontend/.nuxt/          # Nuxt.js 사용 시
/frontend/.vite/          # Vite 빌드 시
/frontend/package-lock.json
/frontend/pnpm-lock.yaml
/frontend/yarn.lock

##################################
# 🗂️ 기타 공통
##################################
/build/
/out/
/.env
.env.*     # 루트에서 실수로 생기는 경우도 막음
*.env
*.env.*

# 압축/백업 파일
*.zip
*.tar
*.gz
*.rar

