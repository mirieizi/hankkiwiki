<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hankki.domain.diet.mapper.UserDietFoodMapper">

    <select id="findFoodIdIdsByDietId" resultType="long" parameterType="long">
        SELECT food_id FROM user_diet_food_map WHERE diet_id = #{dietId}
    </select>

    <insert id="insertUserDietFoodMap" parameterType="com.hankki.domain.diet.entity.UserDietFoodMap">
        INSERT INTO user_diet_food_map (diet_id, food_id)
        VALUES (#{dietId}, #{foodId})
    </insert>

    <delete id="deleteByDietId" parameterType="long">
        DELETE FROM user_diet_food_map WHERE diet_id = #{dietId}
    </delete>

    <select id="findFoodIdsByUserIdAndTakeAtBetween" resultType="long">
            SELECT udf.food_id
            FROM user_diet_food_map udf
            JOIN diet d ON udf.diet_id = d.id
            WHERE d.user_id = #{userId}
            AND d.take_at BETWEEN #{start} AND #{end}
    </select>

</mapper>
